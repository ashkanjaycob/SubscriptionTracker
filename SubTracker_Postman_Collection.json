{
  "info": {
    "name": "SubTracker API",
    "description": "Full collection for the SubTracker API with predefined variables and authorization setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "subscriptionId",
      "value": "100100101",
      "type": "string"
    },
    {
      "key": "channelId",
      "value": "100100101",
      "type": "string"
    },
    {
      "key": "scheduleId",
      "value": "100100101",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Get All Subscriptions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions"]
            }
          }
        },
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Disney+\",\n  \"description\": \"Standard plan\",\n  \"amount\": 7.99,\n  \"billingCycle\": \"monthly\",\n  \"startDate\": \"2026-08-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions"]
            }
          }
        },
        {
          "name": "Get Subscription by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions", "{{subscriptionId}}"]
            }
          }
        },
        {
          "name": "Update Subscription",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9.99,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions", "{{subscriptionId}}"]
            }
          }
        },
        {
          "name": "Delete Subscription",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions", "{{subscriptionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "Get All Channels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["channels"]
            }
          }
        },
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Push Notification\",\n  \"type\": \"push\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["channels"]
            }
          }
        },
        {
          "name": "Delete Channel",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/channels/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["channels", "{{channelId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Get All Schedules",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"]
            }
          }
        },
        {
          "name": "Create Schedule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": \"{{subscriptionId}}\",\n  \"channelId\": \"{{channelId}}\",\n  \"reminderDate\": \"2026-10-01T09:00:00.000Z\",\n  \"message\": \"Renewal reminder\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"]
            }
          }
        },
        {
          "name": "Get Schedule by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "{{scheduleId}}"]
            }
          }
        },
        {
          "name": "Update Schedule",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Updated reminder message\",\n  \"isSent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "{{scheduleId}}"]
            }
          }
        },
        {
          "name": "Delete Schedule",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "{{scheduleId}}"]
            }
          }
        }
      ]
    }
  ]
}
